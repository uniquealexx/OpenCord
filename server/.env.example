HOST=127.0.0.1
PORT=3210
LOG_LEVEL=info
# Локальная разработка без Docker:
PGLITE_DATA_DIR=.data/opencord
# На VPS вместо PGlite:
# DATABASE_URL=postgresql://opencord:change-me@127.0.0.1:5432/opencord
# В Docker Compose строка подключения передаётся через secret-файл:
# DATABASE_URL_FILE=/run/secrets/database_url
