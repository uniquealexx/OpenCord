#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

MANAGEMENT_ROOT="/home/opencord"
SETTINGS_FILE="${MANAGEMENT_ROOT}/settings/server.env"

if [[ ! -r "${SETTINGS_FILE}" ]]; then
  printf 'OpenCord settings are missing: %s\n' "${SETTINGS_FILE}" >&2
  exit 1
fi

# This file is installed as root:opencord 0640 and contains paths and public
# deployment settings only. Secrets are never sourced from the management home.
source "${SETTINGS_FILE}"

if [[ "${INSTALL_ROOT:-}" != "/opt/opencord" || "${MANAGEMENT_ROOT}" != "/home/opencord" ]]; then
  printf 'Refusing to operate on an unexpected OpenCord path.\n' >&2
  exit 1
fi
if [[ "${INSTALL_MODE:-}" != "docker" && "${INSTALL_MODE:-}" != "native" ]]; then
  printf 'Unknown OpenCord installation mode.\n' >&2
  exit 1
fi

command_name="${1:-}"
invoked_as="$(basename -- "$0")"
if [[ -z "${command_name}" && "${invoked_as}" == *.sh ]]; then
  command_name="${invoked_as%.sh}"
elif [[ "${invoked_as}" == *.sh ]]; then
  command_name="${invoked_as%.sh}"
else
  shift || true
fi

usage() {
  cat <<'USAGE'
Использование: sudo opencordctl <команда>

Команды:
  status                 состояние OpenCord и его зависимостей
  logs [строки]          последние логи сервера (по умолчанию 200)
  start|stop|restart     управление сервером
  settings               публичные настройки и расположение данных
  backup                 резервная копия PostgreSQL и вложений
  restore <dump> [--attachments <tar>] RESTORE-OPENCORD-BACKUP
                         восстановить PostgreSQL и вложения из резервной копии
  clear-messages DELETE-ALL-MESSAGES
                         удалить всю историю сообщений после создания backup
  check-update [--channel stable]
                         проверить наличие нового стабильного релиза
  update --channel stable
                         скачать проверенный stable bundle, создать backup и обновить сервер
  update --bundle-url URL --sha256 HEX
  update --bundle-file PATH --sha256 HEX
                         проверить bundle, создать backup и обновить сервер
  uninstall              отключить OpenCord, сохранив приложение и данные
  uninstall --purge-data DELETE-OPENCORD-DATA
                         полностью удалить OpenCord и его данные
USAGE
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    printf 'Эта команда должна запускаться через sudo.\n' >&2
    exit 1
  fi
}

compose() {
  local files=(--file "${INSTALL_ROOT}/deploy/compose.yml")
  if [[ "${INSECURE_MODE:-false}" == "true" ]]; then
    files+=(--file "${INSTALL_ROOT}/deploy/compose.insecure.yml")
  fi
  docker compose --project-directory "${INSTALL_ROOT}" --env-file "${INSTALL_ROOT}/deploy/.env" "${files[@]}" "$@"
}

service_action() {
  local action="$1"
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    case "${action}" in
      start) compose up --detach --remove-orphans ;;
      stop) compose stop ;;
      restart) compose restart server livekit ;;
    esac
  else
    systemctl "${action}" opencord-server
  fi
}

inspect_health() {
  local require_voice="${1:-false}"
  local script
  read -r -d '' script <<'NODE' || true
const requireVoice = process.argv[1] === "true";
fetch("http://127.0.0.1:3210/health").then(async (response) => {
  const health = await response.json();
  const validCommit = health.buildCommit === null || /^[a-f0-9]{12}$/.test(health.buildCommit);
  const validVersion = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$/.test(health.version);
  const valid = response.ok && health.status === "ok" && health.service === "opencord-server"
    && validVersion && ["development", "beta", "stable"].includes(health.releaseChannel)
    && Number.isInteger(health.protocolVersion) && validCommit
    && ["postgres", "pglite"].includes(health.database) && ["available", "degraded", "disabled"].includes(health.voice?.status)
    && (health.releaseChannel === "development" || health.buildCommit !== null);
  if (!valid) throw new Error("OpenCord Server returned an invalid health response");
  process.stdout.write(`OpenCord Server: ${health.version} (${health.releaseChannel}, ${health.buildCommit ?? "local"})\nProtocol: ${health.protocolVersion}\n`);
  process.stdout.write(`Voice: ${health.voice?.status ?? "unknown"}${health.voice?.warning ? ` — ${health.voice.warning}` : ""}\n`);
  if (requireVoice && health.voice?.status !== "available") process.exitCode = 2;
}).catch((error) => { process.stderr.write(`${error.message}\n`); process.exitCode = 1; });
NODE
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    compose exec -T server node -e "${script}" "${require_voice}"
  else
    node -e "${script}" "${require_voice}"
  fi
}

show_status() {
  printf 'Режим установки: %s\n' "${INSTALL_MODE}"
  printf 'Адрес сервера: %s\n' "${PUBLIC_ENDPOINT:-не задан}"
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    compose ps
  else
    systemctl status opencord-server --no-pager
    printf '\nPostgreSQL:\n'
    systemctl is-active postgresql
    if [[ "${INSECURE_MODE:-false}" != "true" ]]; then
      printf 'Caddy: '
      systemctl is-active caddy
    fi
  fi
  printf '\nHealth:\n'
  inspect_health false
}

doctor() {
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    local server_id livekit_id
    server_id="$(compose ps --status running --quiet server)"
    livekit_id="$(compose ps --status running --quiet livekit)"
    if [[ -z "${server_id}" || -z "${livekit_id}" ]]; then
      printf 'OpenCord Server or LiveKit is not running. Run: sudo opencordctl status\n' >&2
      return 1
    fi
  elif ! systemctl is-active --quiet opencord-server; then
    printf 'OpenCord Server is not running. Run: sudo opencordctl status\n' >&2
    return 1
  fi
  if ! inspect_health true; then
    printf 'The text server is unavailable or the voice subsystem is degraded.\n' >&2
    return 1
  fi
  printf 'OpenCord Server and voice subsystem are available.\n'
}

show_logs() {
  local lines="${1:-200}"
  if [[ ! "${lines}" =~ ^[0-9]+$ || "${lines}" -lt 1 || "${lines}" -gt 5000 ]]; then
    printf 'Количество строк должно быть числом от 1 до 5000.\n' >&2
    exit 1
  fi
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    compose logs --tail "${lines}" server
  else
    journalctl -u opencord-server -n "${lines}" --no-pager
  fi
}

show_settings() {
  cat <<SETTINGS
Режим:                 ${INSTALL_MODE}
Публичный адрес:       ${PUBLIC_ENDPOINT:-не задан}
Приложение:            /opt/opencord
Управление:            /home/opencord
Резервные копии:       /home/opencord/backups
Публичные настройки:   /home/opencord/settings/server.env
SETTINGS
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    cat <<'SETTINGS'
Секреты:               /opt/opencord/deploy/secrets (только root)
База:                  Docker volume opencord_postgres_data
Compose:               /opt/opencord/deploy/compose.yml
SETTINGS
  else
    cat <<'SETTINGS'
Секреты:               /etc/opencord (только root/opencord)
База:                  системный PostgreSQL, база opencord
Служба:                /etc/systemd/system/opencord-server.service
SETTINGS
  fi
  printf '\nИзменение сетевого режима или домена выполняется повторным развёртыванием из OpenCord Client.\n'
}

create_backup() {
  local timestamp backup_path temporary_path attachments_path attachments_temporary_path
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_path="${MANAGEMENT_ROOT}/backups/opencord-${timestamp}-$$.dump"
  temporary_path="${backup_path}.tmp"
  attachments_path="${MANAGEMENT_ROOT}/backups/opencord-${timestamp}-$$.attachments.tar"
  attachments_temporary_path="${attachments_path}.tmp"
  install -d -m 0750 -o root -g opencord "${MANAGEMENT_ROOT}/backups"
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    if ! compose exec -T database pg_dump --username opencord --format=custom opencord > "${temporary_path}"; then
      rm -f -- "${temporary_path}"
      printf 'Не удалось создать резервную копию PostgreSQL.\n' >&2
      return 1
    fi
  else
    if ! runuser -u postgres -- pg_dump --format=custom opencord > "${temporary_path}"; then
      rm -f -- "${temporary_path}"
      printf 'Не удалось создать резервную копию PostgreSQL.\n' >&2
      return 1
    fi
  fi
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    if ! compose run --rm --no-deps --user 10001:10001 --entrypoint tar server -C /var/lib/opencord/attachments -cf - . > "${attachments_temporary_path}"; then
      rm -f -- "${temporary_path}" "${attachments_temporary_path}"
      printf 'Не удалось создать резервную копию вложений.\n' >&2
      return 1
    fi
  else
    if ! tar -C /var/lib/opencord/attachments -cf "${attachments_temporary_path}" .; then
      rm -f -- "${temporary_path}" "${attachments_temporary_path}"
      printf 'Не удалось создать резервную копию вложений.\n' >&2
      return 1
    fi
  fi
  mv -- "${temporary_path}" "${backup_path}"
  mv -- "${attachments_temporary_path}" "${attachments_path}"
  chmod 0640 "${backup_path}" "${attachments_path}"
  chown root:opencord "${backup_path}" "${attachments_path}"
  printf 'Резервные копии созданы: %s и %s\n' "${backup_path}" "${attachments_path}"
}

restore_backup() {
  local dump_path="" attachments_path="" was_running="false" message_count attachment_count
  local safety_backup_message attempt

  if [[ $# -lt 1 || "${!#}" != "RESTORE-OPENCORD-BACKUP" ]]; then
    printf 'Для восстановления добавьте точную фразу: RESTORE-OPENCORD-BACKUP\n' >&2
    return 1
  fi
  local -a restore_args=("${@:1:$#-1}")

  # Parse the positional dump path and the optional --attachments override.
  while [[ ${#restore_args[@]} -gt 0 ]]; do
    case "${restore_args[0]}" in
      --attachments)
        if [[ ${#restore_args[@]} -lt 2 || -n "${attachments_path}" ]]; then
          printf 'Использование: sudo opencordctl restore <dump> [--attachments <tar>] RESTORE-OPENCORD-BACKUP\n' >&2
          return 1
        fi
        attachments_path="${restore_args[1]}"
        restore_args=("${restore_args[@]:2}")
        ;;
      -*)
        printf 'Неизвестный параметр: %s\n' "${restore_args[0]}" >&2
        return 1
        ;;
      *)
        if [[ -n "${dump_path}" ]]; then
          printf 'Указано несколько путей к дампу.\n' >&2
          return 1
        fi
        dump_path="${restore_args[0]}"
        restore_args=("${restore_args[@]:1}")
        ;;
    esac
  done
  if [[ -z "${dump_path}" ]]; then
    printf 'Использование: sudo opencordctl restore <dump> [--attachments <tar>] RESTORE-OPENCORD-BACKUP\n' >&2
    return 1
  fi
  if [[ -z "${attachments_path}" ]]; then
    if [[ "${dump_path}" == *.dump ]]; then
      attachments_path="${dump_path%.dump}.attachments.tar"
    else
      printf 'Не удалось определить архив вложений: путь к дампу должен заканчиваться на .dump либо укажите --attachments.\n' >&2
      return 1
    fi
  fi

  # Validate every input before touching the current state.
  if [[ ! -f "${dump_path}" || ! -r "${dump_path}" || ! -s "${dump_path}" ]]; then
    printf 'Файл дампа не найден, недоступен для чтения или пуст: %s\n' "${dump_path}" >&2
    return 1
  fi
  if [[ "$(head -c 5 -- "${dump_path}")" != "PGDMP" ]]; then
    printf 'Файл дампа не является дампом PostgreSQL в custom-формате: %s\n' "${dump_path}" >&2
    return 1
  fi
  if [[ ! -f "${attachments_path}" || ! -r "${attachments_path}" || ! -s "${attachments_path}" ]]; then
    printf 'Архив вложений не найден, недоступен для чтения или пуст: %s\n' "${attachments_path}" >&2
    return 1
  fi
  if ! tar --list --file "${attachments_path}" >/dev/null 2>&1; then
    printf 'Архив вложений повреждён или не читается: %s\n' "${attachments_path}" >&2
    return 1
  fi

  restart_after_restore() {
    if [[ "${was_running}" != "true" ]]; then return 0; fi
    if [[ "${INSTALL_MODE}" == "docker" ]]; then
      compose up --detach server
    else
      systemctl start opencord-server
    fi
  }

  # Make sure the database is available before restoring into it.
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    compose up --detach database
    for attempt in $(seq 1 30); do
      if compose exec -T database pg_isready --username opencord --dbname opencord >/dev/null 2>&1; then
        break
      fi
      if [[ "${attempt}" -eq 30 ]]; then
        printf 'PostgreSQL не готов к восстановлению.\n' >&2
        return 1
      fi
      sleep 1
    done
  else
    if ! systemctl is-active --quiet postgresql; then
      systemctl start postgresql
    fi
    for attempt in $(seq 1 30); do
      if runuser -u postgres -- pg_isready -q; then
        break
      fi
      if [[ "${attempt}" -eq 30 ]]; then
        printf 'PostgreSQL не готов к восстановлению.\n' >&2
        return 1
      fi
      sleep 1
    done
  fi

  # Mandatory safety backup of the current state. Nothing has changed yet.
  if ! safety_backup_message="$(create_backup)"; then
    printf 'Восстановление отменено: не удалось создать резервную копию текущего состояния.\n' >&2
    return 1
  fi

  # Stop only the OpenCord Server process, remembering whether it was running.
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    if [[ -n "$(compose ps --status running --quiet server)" ]]; then
      was_running="true"
      compose stop server
    fi
  elif systemctl is-active --quiet opencord-server; then
    was_running="true"
    systemctl stop opencord-server
  fi

  # Restore PostgreSQL atomically.
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    if ! compose exec -T database pg_restore --username opencord --dbname opencord --clean --if-exists --single-transaction --exit-on-error < "${dump_path}"; then
      restart_after_restore || true
      printf 'Не удалось восстановить PostgreSQL.\n' >&2
      return 1
    fi
  else
    if ! runuser -u postgres -- pg_restore --dbname opencord --clean --if-exists --single-transaction --exit-on-error < "${dump_path}"; then
      restart_after_restore || true
      printf 'Не удалось восстановить PostgreSQL.\n' >&2
      return 1
    fi
  fi

  # Restore attachments into the clean attachments directory.
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    if ! { compose run --rm --no-deps attachments-init \
      && compose run --rm -T --no-deps --user 10001:10001 --entrypoint sh server -c 'find /var/lib/opencord/attachments -mindepth 1 -delete; tar -C /var/lib/opencord/attachments -xf -' < "${attachments_path}"; }; then
      restart_after_restore || true
      printf 'Не удалось восстановить вложения.\n' >&2
      return 1
    fi
  else
    if ! { install -d -m 0700 -o opencord -g opencord /var/lib/opencord/attachments \
      && find /var/lib/opencord/attachments -mindepth 1 -delete \
      && tar -C /var/lib/opencord/attachments -xf "${attachments_path}" \
      && chown -R opencord:opencord /var/lib/opencord/attachments; }; then
      restart_after_restore || true
      printf 'Не удалось восстановить вложения.\n' >&2
      return 1
    fi
  fi

  # Restart the server only if it was running before the restore.
  if [[ "${was_running}" == "true" ]]; then
    if ! restart_after_restore; then
      printf 'Восстановление завершено, но OpenCord Server не удалось запустить. Проверьте sudo opencordctl status и logs.\n' >&2
      return 1
    fi
  else
    printf 'OpenCord Server был остановлен до восстановления и остаётся остановленным. Запустите: sudo opencordctl start\n'
  fi

  # Verify the restored state and report it.
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    message_count="$(compose exec -T database psql --username opencord --dbname opencord --tuples-only --no-align --command 'SELECT count(*) FROM messages;')"
    attachment_count="$(compose run --rm -T --no-deps --user 10001:10001 --entrypoint sh server -c 'find /var/lib/opencord/attachments -mindepth 1 | wc -l')"
  else
    message_count="$(runuser -u postgres -- psql --dbname opencord --tuples-only --no-align --command 'SELECT count(*) FROM messages;')"
    attachment_count="$(find /var/lib/opencord/attachments -mindepth 1 | wc -l)"
  fi
  message_count="${message_count//[[:space:]]/}"
  attachment_count="${attachment_count//[[:space:]]/}"
  if [[ ! "${message_count}" =~ ^[0-9]+$ ]]; then message_count="неизвестно"; fi
  if [[ ! "${attachment_count}" =~ ^[0-9]+$ ]]; then attachment_count="неизвестно"; fi

  if [[ "${was_running}" == "true" ]] && ! inspect_health false; then
    printf 'Сервер запущен, но healthcheck не прошёл.\n' >&2
    return 1
  fi

  printf 'Восстановление завершено: %s и %s; сообщений: %s; файлов вложений: %s.\n' "${dump_path}" "${attachments_path}" "${message_count}" "${attachment_count}"
  printf 'Состояние до восстановления сохранено: %s\n' "${safety_backup_message}"
}

clear_messages() {
  local confirmation="${1:-}" was_running="false" deleted_count
  if [[ "${confirmation}" != "DELETE-ALL-MESSAGES" || $# -ne 1 ]]; then
    printf 'Для удаления всей истории добавьте точную фразу: clear-messages DELETE-ALL-MESSAGES\n' >&2
    return 1
  fi

  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    if [[ -n "$(compose ps --status running --quiet server)" ]]; then
      was_running="true"
      compose stop server
    fi
  elif systemctl is-active --quiet opencord-server; then
    was_running="true"
    systemctl stop opencord-server
  fi

  restart_after_clear() {
    if [[ "${was_running}" != "true" ]]; then return 0; fi
    if [[ "${INSTALL_MODE}" == "docker" ]]; then
      compose up --detach server
    else
      systemctl start opencord-server
    fi
  }

  if ! create_backup; then
    restart_after_clear || true
    printf 'История не удалена: не удалось создать обязательную резервную копию.\n' >&2
    return 1
  fi

  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    if ! deleted_count="$(compose exec -T database psql --username opencord --dbname opencord --set ON_ERROR_STOP=1 --tuples-only --no-align --command 'WITH deleted AS (DELETE FROM messages RETURNING 1) SELECT count(*) FROM deleted;')"; then
      restart_after_clear || true
      printf 'Не удалось очистить историю сообщений.\n' >&2
      return 1
    fi
  else
    if ! deleted_count="$(runuser -u postgres -- psql --dbname opencord --set ON_ERROR_STOP=1 --tuples-only --no-align --command 'WITH deleted AS (DELETE FROM messages RETURNING 1) SELECT count(*) FROM deleted;')"; then
      restart_after_clear || true
      printf 'Не удалось очистить историю сообщений.\n' >&2
      return 1
    fi
  fi

  if ! restart_after_clear; then
    printf 'Сообщения удалены, но OpenCord Server не удалось запустить. Проверьте sudo opencordctl status и logs.\n' >&2
    return 1
  fi
  if [[ ! "${deleted_count}" =~ ^[0-9]+$ ]]; then deleted_count="неизвестно"; fi
  printf 'История сообщений очищена. Удалено сообщений: %s.\n' "${deleted_count}"
}

disable_installation() {
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    compose down --remove-orphans
  else
    systemctl disable --now opencord-server || true
    rm -f -- /etc/systemd/system/opencord-server.service
    systemctl daemon-reload
    if [[ -f /etc/caddy/Caddyfile ]] && grep -q '^# Managed by OpenCord$' /etc/caddy/Caddyfile; then
      systemctl stop caddy || true
      mv -- /etc/caddy/Caddyfile /etc/caddy/Caddyfile.opencord-disabled
    fi
  fi
  touch "${MANAGEMENT_ROOT}/.uninstalled"
  printf 'OpenCord остановлен и отключён. Приложение, настройки, база и резервные копии сохранены.\n'
  printf 'Для повторной установки запустите развёртывание из OpenCord Client.\n'
}

purge_installation() {
  if [[ "${INSTALL_MODE}" == "docker" ]]; then
    compose down --volumes --remove-orphans
  else
    systemctl disable --now opencord-server || true
    rm -f -- /etc/systemd/system/opencord-server.service
    systemctl daemon-reload
    runuser -u postgres -- dropdb --if-exists opencord
    runuser -u postgres -- dropuser --if-exists opencord
    if [[ -f /etc/caddy/Caddyfile ]] && grep -q '^# Managed by OpenCord$' /etc/caddy/Caddyfile; then
      systemctl stop caddy || true
      rm -f -- /etc/caddy/Caddyfile
    fi
    rm -rf -- /etc/opencord
    rm -rf -- /var/lib/opencord
  fi
  rm -rf -- /opt/opencord
  if [[ -L /usr/local/bin/opencordctl && "$(readlink /usr/local/bin/opencordctl)" == "/home/opencord/opencordctl" ]]; then
    rm -f -- /usr/local/bin/opencordctl
  fi
  rm -rf -- /home/opencord
  userdel opencord >/dev/null 2>&1 || true
  groupdel opencord >/dev/null 2>&1 || true
  printf 'OpenCord, его база, настройки и локальные резервные копии удалены.\n'
}

require_root
case "${command_name}" in
  status) show_status ;;
  doctor) doctor ;;
  logs) show_logs "${1:-200}" ;;
  start|stop|restart) service_action "${command_name}" ;;
  settings) show_settings ;;
  backup) create_backup ;;
  restore) restore_backup "$@" ;;
  clear-messages) clear_messages "$@" ;;
  check-update) "${MANAGEMENT_ROOT}/libexec/update-server" --check-only "$@" ;;
  update) "${MANAGEMENT_ROOT}/libexec/update-server" "$@" ;;
  uninstall)
    if [[ "${1:-}" == "--purge-data" ]]; then
      if [[ "${2:-}" != "DELETE-OPENCORD-DATA" ]]; then
        printf 'Для полного удаления добавьте точную фразу: --purge-data DELETE-OPENCORD-DATA\n' >&2
        exit 1
      fi
      purge_installation
    elif [[ $# -eq 0 ]]; then
      disable_installation
    else
      usage
      exit 1
    fi
    ;;
  help|-h|--help|"") usage ;;
  *) usage; exit 1 ;;
esac
