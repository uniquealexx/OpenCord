# syntax=docker/dockerfile:1.7

FROM node:24.18.0-bookworm-slim AS build
ARG OPENCORD_VERSION
ARG OPENCORD_RELEASE_CHANNEL=development
ARG OPENCORD_BUILD_COMMIT
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
ENV OPENCORD_EXPECTED_VERSION=${OPENCORD_VERSION}
ENV OPENCORD_RELEASE_CHANNEL=${OPENCORD_RELEASE_CHANNEL}
ENV OPENCORD_BUILD_COMMIT=${OPENCORD_BUILD_COMMIT}
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY shared/package.json shared/tsconfig.json shared/
COPY server/package.json server/tsconfig.json server/tsup.config.ts server/
RUN --mount=type=cache,id=opencord-pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --filter @opencord/shared... --filter @opencord/server...
COPY shared/src shared/src
COPY server/src server/src
RUN pnpm --filter @opencord/shared build \
  && pnpm --filter @opencord/server build \
  && pnpm --filter @opencord/server --prod deploy --legacy /runtime \
  && mkdir -p /output \
  && tar --create --gzip --file /output/server-runtime-linux-x64.tar.gz \
    --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --directory /runtime .

FROM node:24.18.0-bookworm-slim AS runtime
ARG OPENCORD_VERSION
ARG OPENCORD_RELEASE_CHANNEL
ARG OPENCORD_BUILD_COMMIT
LABEL org.opencontainers.image.title="OpenCord Server" \
  org.opencontainers.image.version=${OPENCORD_VERSION} \
  org.opencontainers.image.revision=${OPENCORD_BUILD_COMMIT} \
  org.opencontainers.image.vendor="OpenCord" \
  org.opencontainers.image.source="https://github.com/uniquealexx/OpenCord" \
  io.opencord.release.channel=${OPENCORD_RELEASE_CHANNEL}
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3210
RUN groupadd --system --gid 10001 opencord \
  && useradd --system --uid 10001 --gid opencord --home-dir /app --shell /usr/sbin/nologin opencord
WORKDIR /app
COPY --from=build --chown=opencord:opencord /runtime ./
USER opencord
EXPOSE 3210
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3210/health').then(async r=>{const h=await r.json();if(!r.ok||h.status!=='ok'||h.service!=='opencord-server')process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "dist/index.js"]

FROM scratch AS export
COPY --from=build /output/server-runtime-linux-x64.tar.gz /
