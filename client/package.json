{
  "name": "@opencord/client",
  "version": "0.1.0-beta.14",
  "private": true,
  "license": "MIT",
  "description": "OpenCord desktop client prototype",
  "homepage": "https://github.com/uniquealexx/OpenCord",
  "desktopName": "opencord.desktop",
  "author": {
    "name": "OpenCord maintainers",
    "email": "maintainers@opencord.local"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build:electron": "tsup",
    "build:renderer": "next build",
    "build": "pnpm build:renderer && pnpm build:electron",
    "android:sync": "cap sync android",
    "android:debug": "pnpm build:renderer && cap sync android && node scripts/build-android.mjs debug",
    "android:release": "pnpm build:renderer && cap sync android && node scripts/build-android.mjs release",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "package:linux": "pnpm build && node scripts/package-linux.mjs",
    "package:mac": "pnpm build && electron-builder --mac dmg zip --universal --publish never",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "pnpm --filter @opencord/shared build && pnpm --filter @opencord/server build && pnpm build && playwright test"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@opencord/shared": "workspace:*",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@sapphi-red/web-noise-suppressor": "0.3.5",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.21.0",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ssh2": "1.17.0",
    "tailwind-merge": "latest",
    "tar": "7.5.20",
    "zod": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ssh2": "1.15.5",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "^9.39.0",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "tailwindcss": "latest",
    "tsup": "latest",
    "typescript": "^6.0.0",
    "vitest": "latest"
  },
  "build": {
    "appId": "org.opencord.desktop",
    "productName": "OpenCord",
    "asar": true,
    "npmRebuild": false,
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "uniquealexx",
        "repo": "OpenCord"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/sharp/**/*",
      "!node_modules/@img/**/*",
      "!node_modules/cpu-features/**/*",
      "!node_modules/@next/swc-*/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OpenCord-Setup-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "opencord",
      "category": "Network",
      "syncDesktopName": true,
      "artifactName": "OpenCord-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "artifactName": "OpenCord-${version}-${arch}.${ext}"
    }
  }
}
